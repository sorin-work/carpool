# Copy to .env and adjust; docker compose reads it automatically.

# Port the web app is published on.
WEB_PORT=4419
# Port PostgreSQL is published on, for local development against the compose database.
DB_PORT=5442

POSTGRES_USER=carpool
POSTGRES_PASSWORD=carpool
POSTGRES_DB=carpool

# Signs the login tokens. Use a long random value outside local development.
JWT_SECRET=local-development-secret-change-me-0123456789
# How long a login lasts (Spring duration: 7d, 12h, ...).
JWT_TTL=7d

# Creates demo@carpool.local / demo-password with sample data on first start.
SEED_DEMO=true
